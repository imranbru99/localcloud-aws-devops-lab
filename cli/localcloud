#!/usr/bin/env bash
set -e

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
DIR="$( cd -P "$( dirname "$SOURCE" )/.." >/dev/null 2>&1 && pwd )"

BIN="$DIR/bin/localcloud-gateway"
PID_FILE="$DIR/data/localcloud.pid"
DATA_DIR="$DIR/data"

export PATH="/home/imran/.local/go/bin:/home/imran/.local/bin:$PATH"

function build_if_needed() {
  if [ ! -f "$BIN" ]; then
    echo "Compiling LocalCloud gateway in $DIR..."
    mkdir -p "$DIR/bin"
    (cd "$DIR" && go build -o "$BIN" ./gateway/cmd/gateway/main.go)
  fi
}

function is_running() {
  if curl -s -m 1 http://127.0.0.1:4566/api/stats >/dev/null 2>&1; then
    return 0
  fi
  return 1
}

case "$1" in
  start)
    build_if_needed
    mkdir -p "$DATA_DIR"
    if is_running; then
      echo "LocalCloud is ALREADY RUNNING on port 4566!"
      echo "  • AWS API Endpoint:        http://127.0.0.1:4566"
      echo "  • Web Management Console:   http://127.0.0.1:4566/console"
      echo "  • Live API Inspector:      http://127.0.0.1:4566/api/stream/inspector"
      exit 0
    fi
    echo "Starting LocalCloud gateway on port 4566..."
    export LOCALCLOUD_DATA_DIR="$DATA_DIR"
    setsid "$BIN" </dev/null > "$DATA_DIR/gateway.log" 2>&1 &
    PID=$!
    echo $PID > "$PID_FILE"
    sleep 1
    if is_running; then
      echo "LocalCloud started successfully!"
      echo "  • AWS API Endpoint:        http://127.0.0.1:4566"
      echo "  • Web Management Console:   http://127.0.0.1:4566/console"
      echo "  • Live API Inspector:      http://127.0.0.1:4566/api/stream/inspector"
      echo ""
      echo "AWS CLI Usage:"
      echo "  aws --endpoint-url http://localhost:4566 sts get-caller-identity"
    else
      echo "Failed to start LocalCloud. Check $DATA_DIR/gateway.log"
      exit 1
    fi
    ;;

  stop)
    echo "Stopping LocalCloud on port 4566..."
    fuser -k 4566/tcp 2>/dev/null || true
    pkill -f localcloud-gateway 2>/dev/null || true
    rm -f "$PID_FILE"
    echo "LocalCloud stopped."
    ;;

  status)
    if is_running; then
      echo "LocalCloud is RUNNING on port 4566"
      curl -s http://127.0.0.1:4566/api/stats | python3 -m json.tool 2>/dev/null || true
    else
      echo "LocalCloud is STOPPED"
    fi
    ;;

  reset)
    echo "Resetting LocalCloud state..."
    if is_running; then
      curl -s -X POST http://127.0.0.1:4566/api/reset > /dev/null || true
    fi
    rm -rf "$DATA_DIR/s3" "$DATA_DIR/cloudtrail"
    mkdir -p "$DATA_DIR/s3" "$DATA_DIR/cloudtrail"
    echo "LocalCloud state reset cleanly."
    ;;

  doctor)
    echo "=================================================="
    echo "            LocalCloud Doctor & Diagnostics       "
    echo "=================================================="
    echo "System Information:"
    echo "  OS:           $(uname -s) $(uname -r) ($(uname -m))"
    echo "  RAM:          $(free -h 2>/dev/null | awk '/^Mem:/ {print $2}')"
    echo "  Disk Free:    $(df -h "$DIR" | awk 'NR==2 {print $4}')"
    echo ""
    echo "Installed Tools:"
    echo "  Go:           $(go version 2>/dev/null || echo 'Not found')"
    echo "  AWS CLI:      $(aws --version 2>&1 | head -n 1 || echo 'Not found')"
    echo "  Python:       $(python3 --version 2>/dev/null || echo 'Not found')"
    echo "  Container:    $(docker --version 2>/dev/null || podman --version 2>/dev/null || echo 'None')"
    echo ""
    echo "Profile Recommendation:"
    echo "  [✓] 'lite' profile (~5 GB disk, 4 GB RAM) is fully supported."
    echo "  [✓] 'standard' profile (~20 GB disk, 8 GB RAM) is supported."
    echo "=================================================="
    ;;

  snapshot)
    ARCHIVE="localcloud-snapshot-$(date +%Y%m%d%H%M%S).tar.gz"
    echo "Creating state snapshot: $ARCHIVE"
    tar -czf "$ARCHIVE" -C "$DIR" data
    echo "Snapshot saved to $ARCHIVE"
    ;;

  *)
    echo "Usage: ./localcloud {start|stop|status|reset|doctor|snapshot} [--profile lite|standard|full]"
    exit 1
    ;;
esac
